{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "description": "Đảo Đèn Lồng: game 3D (WebGL, không thư viện ngoài) với chế độ headless theo Test Contract",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node tools/serve.js --open",
    "serve": "node tools/serve.js",
    "headless": "node src/headless.js",
    "test": "node scripts/run-tests.js",
    "bench": "node tools/bench.js --seed 42 --duration 30 --out bench.json",
    "soak": "node tools/soak.js --seed 7 --nights 10 --out soak.json",
    "proof": "node tools/proof.js",
    "capture": "node tools/capture.mjs",
    "release": "node tools/release.js",
    "verify": "sh scripts/verify.sh"
  }
}
